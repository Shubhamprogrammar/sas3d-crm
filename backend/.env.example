# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Render/Vercel rewrite = 1). Used for client IPs in rate limiting.
TRUST_PROXY=1

# Database. Transactions need a replica set: see docs/DATABASE.md
MONGODB_URI=mongodb://localhost:27017/sas3d_crm?replicaSet=rs0

# Authentication
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Public origin the browser uses to reach the API. With the recommended Next.js rewrite, this is the frontend origin.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated browser origins allowed by CORS and Better Auth.
FRONTEND_URL=http://localhost:3000
# Only for frontend/backend on separate subdomains without the rewrite, e.g. .sas3d.in
COOKIE_DOMAIN=

# Initial administrator (read only by the seed script)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_NAME=SAS3D Owner

# Email: without RESEND_API_KEY, emails are logged and reported as not sent.
RESEND_API_KEY=
EMAIL_FROM=SAS3D CRM <crm@sas3d.in>

# Attachments: "local" stores on disk, "cloudinary" needs the three values below.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Background jobs. A Mongo lock prevents duplicate runs across instances.
JOBS_ENABLED=true
JOB_INTERVAL_SECONDS=300

# Only for `npm run seed:demo`
DEMO_USER_PASSWORD=
